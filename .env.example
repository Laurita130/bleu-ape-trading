# Get a free key at https://finnhub.io/register (no credit card required)
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Get a free key at https://console.cloud.google.com/apis/credentials
# (create a project, then Enable APIs -> search "YouTube Data API v3" -> Enable,
# then Credentials -> Create Credentials -> API key)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
